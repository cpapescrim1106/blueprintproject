# Copy this file to `.env.local` in the repo root and adjust values as needed.

# Postgres database used by Prisma + dashboard.
# Port matches docker-compose (host 55432 -> container 5432).
DATABASE_URL=postgresql://blueprint:blueprint@localhost:55432/blueprint?schema=public

# AWS credentials are required when replaying reports against S3/SQS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2

# Convex + RingCentral configuration
CONVEX_URL=
CONVEX_DEPLOY_KEY=
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=
RINGCENTRAL_JWT=
RINGCENTRAL_FROM_NUMBER=
RINGCENTRAL_WEBHOOK_URL=https://blueprintproject.scrimvivbes.xyz/api/ringcentral/inbound
